DEBUG=True

SECRET_KEY=ChangeMe

ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_NAME=recipes
DATABASE_USER=recipes
DATABASE_PASSWORD=recipes
DATABASE_HOST=postgres
DATABASE_PORT=5432
POSTGRES_PORT=5436

BACKEND_PORT=8008

FRONTEND_PORT=3008

# Nuxt's runtimeConfig.public.apiUrl (nuxt.config.ts) - NUXT_PUBLIC_API_URL is
# Nuxt's standard env override name for that key (NUXT_PUBLIC_ + SCREAMING_SNAKE_CASE).
# Read both server-side (SSR) and client-side (browser fetch), so in prod
# this must be the API's real public URL, not an internal Docker service name.
NUXT_PUBLIC_API_URL=http://localhost:8008/api

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3008

AZURE_CLIENT_ID='azure_client_id'
AZURE_TENANT_ID='azure_tenant_id'
AZURE_CLIENT_SECRET='azure_client_secret'
AZURE_REDIRECT_URI='http://localhost:3008/connect/microsoft/callback'
AZURE_AUTHORITY='https://login.microsoftonline.com/common/'